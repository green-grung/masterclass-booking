APP_NAME="ОчУмелые ручки CI"
APP_ENV=testing
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=sqlite
# Для SQLite in-memory строка подключения не нужна, только DB_CONNECTION

# Если используете MySQL для CI (не рекомендуется, лучше sqlite), укажите:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=testing
# DB_USERNAME=root
# DB_PASSWORD=

APP_KEY=